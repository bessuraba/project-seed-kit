# Copy to .env and fill in real values. .env itself is gitignored — .env.example is the tracked
# template. Scripts/skills that need project-specific values (an Apify actor slug, an API base URL,
# etc.) should read them from here instead of hardcoding them inline.

# Used by the apify-cli-debug skill (skills/apify-cli-debug/SKILL.md) — the Apify Actor this
# project builds, as owner/actor-name (find it in apify.json or the Console URL).
APIFY_ACTOR_SLUG=owner/actor-name
